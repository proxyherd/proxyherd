{
    "name": "fingerprint-app",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "root": "packages/fingerprint/app",
    "sourceRoot": "packages/fingerprint/app/src",
    "projectType": "application",
    "targets": {
        "build": {
            "executor": "@nx/webpack:webpack",
            "outputs": [
                "{options.outputPath}"
            ],
            "options": {
                "target": "node",
                "compiler": "tsc",
                "outputPath": "dist/fingerprint",
                "outputFileName": "fingerprint.js",
                "main": "packages/fingerprint/app/src/main.ts",
                "tsConfig": "packages/fingerprint/app/tsconfig.app.json",
                "isolatedConfig": true,
                "webpackConfig": "packages/fingerprint/app/webpack.config.js",
                "generatePackageJson": true,
                "extractLicenses": false
            },
            "configurations": {
                "production": {
                    "optimization": true,
                    "extractLicenses": true,
                    "inspect": false
                }
            }
        },
        "build-docker": {
            "command": "docker build --no-cache -f packages/fingerprint/app/Dockerfile . -t ghcr.io/proxyherd/fingerprint"
        },
        "serve": {
            "executor": "@nx/js:node",
            "options": {
                "buildTarget": "fingerprint-app:build",
                "watch": false,
                "port": 0
            }
        },
        "lint": {
            "executor": "@nx/linter:eslint",
            "outputs": [
                "{options.outputFile}"
            ],
            "options": {
                "lintFilePatterns": [
                    "packages/fingerprint/app/**/*.ts"
                ],
                "fix": true
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": [
                "{workspaceRoot}/coverage/{projectRoot}"
            ],
            "options": {
                "jestConfig": "packages/fingerprint/app/jest.config.ts",
                "passWithNoTests": true,
                "runInBand": true
            }
        }
    },
    "tags": []
}

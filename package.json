    "name": "proxyherd",
    "version": "1.0.0",
    "author": {
        "name": "Rakesh Jana",
        "url": "https://github.com/rjanain"
    },
    "description": "Open-source super proxy manager: one endpoint for all your proxies. Builds a pool of private proxies from your cloud accounts, integrates proxy vendors, handles IP rotation, health checks and sticky sessions. Community fork of Scrapoxy 4.17.4 (MIT).",
    "url": "https://github.com/proxyherd/proxyherd",
    "homepage": "https://proxyherd.github.io/proxyherd/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/proxyherd/proxyherd.git"
    },
    "license": "MIT",
    "private": true,
    "scripts": {
        "nx": "nx",
        "build": "nx run-many --target=build",
        "build:production": "nx run-many --target=build --configuration production",
        "build:docker": "nx run-many --target=build-docker --skip-nx-cache --configuration production",
        "lint": "nx run-many --target=lint",
        "prepare": "husky install",
        "start:frontend-app": "nx serve frontend-app",
        "start:frontend-app:production": "nx serve frontend-app --configuration production",
        "start:backend-app": "nx serve backend-app",
        "start:backend-app:production": "nx serve backend-app --configuration production",
        "start:website": "nx serve website",
        "test": "nx run-many --target=test"
    },
